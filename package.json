{
  "name": "mathen",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mcp"
  ],
  "scripts": {
    "dev": "concurrently -k \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "cd apps/web && bun run build",
    "check": "bun run check:api && bun run check:web && bun run check:mcp",
    "check:api": "cd apps/api && bun run check",
    "check:web": "cd apps/web && bun run check",
    "check:mcp": "cd apps/mcp && bun run check",
    "test:api": "bun test apps/api/src/*.test.ts",
    "test:web": "bun test apps/web/src/*.test.ts",
    "db:migrate:local": "cd apps/api && bun run db:migrate:local",
    "db:seed:local": "cd apps/api && bun run db:seed:local",
    "db:reset:local": "cd apps/api && bun run db:reset:local",
    "db:query:local": "cd apps/api && wrangler d1 execute mathen-db --local",
    "db:migrate:remote": "cd apps/api && bun run db:migrate:remote",
    "db:seed:remote": "cd apps/api && bun run db:seed:remote",
    "deploy:api": "cd apps/api && bun run deploy",
    "deploy": "bun run build && bun run db:migrate:remote && bun run deploy:api",
    "mcp": "cd apps/mcp && bun run start"
  },
  "devDependencies": {
    "carryctx": "^0.12.0",
    "concurrently": "^9.2.1"
  },
  "patchedDependencies": {
    "3d-force-graph@1.80.1": "patches/3d-force-graph@1.80.1.patch"
  }
}
