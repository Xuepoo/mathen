{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/architecture-typed-composition.schema.json",
  "title": "Mathen Typed Composition Semantics",
  "description": "An evidence-bounded candidate interface contract, not a compatibility proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "components",
    "adapters",
    "boundaries",
    "conflicts",
    "property_effects",
    "preconditions",
    "postconditions",
    "resource_effects",
    "failure_modes",
    "examples",
    "counterexamples",
    "uncertainties",
    "disagreements",
    "discovery",
    "validity_scope",
    "claim_status",
    "claim_type",
    "evidence_ids",
    "proven"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "adapters": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "boundaries": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "property_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/propertyEffect" }
    },
    "preconditions": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "postconditions": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "resource_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "failure_modes": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "examples": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "counterexamples": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "validity_scope": { "$ref": "#/$defs/scope" },
    "claim_type": { "$ref": "#/$defs/claimType" },
    "claim_status": { "$ref": "#/$defs/claimStatus" },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "discovery": { "$ref": "#/$defs/discovery" },
    "uncertainties": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "disagreements": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "proven": { "const": false }
  },
  "$defs": {
    "claimType": {
      "type": "string",
      "enum": ["fact", "inference", "hypothesis", "analogy"]
    },
    "claimStatus": {
      "type": "string",
      "enum": ["proposed", "under-review", "accepted", "rejected", "deprecated"]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "claim_type",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "claim_type", "claim_status", "evidence_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "provides": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "consumes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "adapters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "boundaries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "description",
        "claim_type",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "propertyEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "property",
        "relation",
        "claim_type",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "property": { "type": "string", "minLength": 1 },
        "relation": {
          "type": "string",
          "enum": [
            "shared",
            "preserves",
            "refines",
            "weakens",
            "strengthens",
            "unverified"
          ]
        },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systems",
        "versions",
        "deployment_origins",
        "conditions",
        "exclusions"
      ],
      "properties": {
        "systems": { "type": "array", "items": { "type": "string" } },
        "versions": { "type": "array", "items": { "type": "string" } },
        "deployment_origins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "provenance",
        "source_community",
        "target_community",
        "path",
        "candidate_status"
      ],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "provenance": { "type": "array", "items": { "type": "string" } },
        "source_community": { "type": "string", "minLength": 1 },
        "target_community": { "type": "string", "minLength": 1 },
        "path": { "type": "array", "items": { "type": "string" } },
        "candidate_status": { "const": "candidate" }
      }
    }
  }
}
