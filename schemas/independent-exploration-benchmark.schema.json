{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/independent-exploration-benchmark.schema.json",
  "title": "Mathen MTH-0195 independent cross-system exploration benchmark",
  "description": "Research-only independent task instances with frozen reviewed-card and source digests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "protocol_version", "research_only", "purpose", "source_revisions", "reviewed_card_digests", "reviewed_cards_digest", "task_cards", "task_card_digests", "domain_slices", "evidence_bundle", "partitions", "negative_knowledge", "candidate_contract", "conditions", "future_hooks", "metrics", "review_budget", "non_claims", "outcome"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "protocol_version": {"$ref": "#/$defs/id"},
    "research_only": {"const": true},
    "purpose": {"type": "string", "minLength": 1},
    "source_revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRevision"}},
    "reviewed_card_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cardDigest"}},
    "reviewed_cards_digest": {"$ref": "#/$defs/digest"},
    "task_cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskCard"}},
    "task_card_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskDigest"}},
    "domain_slices": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/domainSlice"}},
    "evidence_bundle": {"$ref": "#/$defs/evidenceBundle"},
    "partitions": {"$ref": "#/$defs/partitions"},
    "negative_knowledge": {"$ref": "#/$defs/negativeKnowledge"},
    "candidate_contract": {"$ref": "#/$defs/candidateContract"},
    "conditions": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/condition"}},
    "future_hooks": {"$ref": "#/$defs/futureHooks"},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "review_budget": {"$ref": "#/$defs/reviewBudget"},
    "non_claims": {"$ref": "#/$defs/strings"},
    "outcome": {"$ref": "#/$defs/outcome"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sourceRevision": {"type": "object", "additionalProperties": false, "required": ["id", "source_ref", "digest", "scope"], "properties": {"id": {"$ref": "#/$defs/id"}, "source_ref": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "scope": {"type": "string", "minLength": 1}}},
    "cardDigest": {"type": "object", "additionalProperties": false, "required": ["system_id", "path", "digest"], "properties": {"system_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["systems", "workload", "time", "deployment"], "properties": {"systems": {"$ref": "#/$defs/strings"}, "workload": {"type": "string", "minLength": 1}, "time": {"type": "string", "minLength": 1}, "deployment": {"type": "string", "minLength": 1}}},
    "taskCard": {"type": "object", "additionalProperties": false, "required": ["id", "task_key", "kind", "partition", "domain", "systems", "question", "input_text", "input_digest", "source_revision_ids", "source_digest", "card_digests", "evidence_ids", "negative_knowledge", "candidate_generation_allowed", "answer_contract", "scope"], "properties": {"id": {"$ref": "#/$defs/id"}, "task_key": {"$ref": "#/$defs/id"}, "kind": {"enum": ["positive", "negative", "unknown", "counterexample", "composition"]}, "partition": {"enum": ["train", "evaluation", "holdout"]}, "domain": {"$ref": "#/$defs/id"}, "systems": {"$ref": "#/$defs/strings"}, "question": {"type": "string", "minLength": 1}, "input_text": {"type": "string", "minLength": 1}, "input_digest": {"$ref": "#/$defs/digest"}, "source_revision_ids": {"$ref": "#/$defs/strings"}, "source_digest": {"$ref": "#/$defs/digest"}, "card_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cardDigest"}}, "evidence_ids": {"$ref": "#/$defs/strings"}, "negative_knowledge": {"type": "boolean"}, "candidate_generation_allowed": {"type": "boolean"}, "answer_contract": {"enum": ["positive-evidence", "candidate", "abstain-boundary", "unknown", "counterexample"]}, "scope": {"$ref": "#/$defs/scope"}}},
    "taskDigest": {"type": "object", "additionalProperties": false, "required": ["id", "digest"], "properties": {"id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}}},
    "domainSlice": {"type": "object", "additionalProperties": false, "required": ["domain", "system_ids", "task_ids", "digest"], "properties": {"domain": {"$ref": "#/$defs/id"}, "system_ids": {"$ref": "#/$defs/strings"}, "task_ids": {"$ref": "#/$defs/strings"}, "digest": {"$ref": "#/$defs/digest"}}},
    "evidenceRecord": {"type": "object", "additionalProperties": false, "required": ["id", "card_id", "card_evidence_id", "source_revision_id", "kind", "claim_type", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "card_id": {"$ref": "#/$defs/id"}, "card_evidence_id": {"$ref": "#/$defs/id"}, "source_revision_id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1}, "claim_type": {"enum": ["fact", "inference", "hypothesis", "analogy"]}, "description": {"type": "string", "minLength": 1}}},
    "evidenceBundle": {"type": "object", "additionalProperties": false, "required": ["id", "records", "digest", "source_revision_digests"], "properties": {"id": {"$ref": "#/$defs/id"}, "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRecord"}}, "digest": {"$ref": "#/$defs/digest"}, "source_revision_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}}},
    "partitions": {"type": "object", "additionalProperties": false, "required": ["sets", "exhaustive", "disjoint", "digest"], "properties": {"sets": {"type": "object", "additionalProperties": false, "required": ["train", "evaluation", "holdout"], "properties": {"train": {"$ref": "#/$defs/strings"}, "evaluation": {"$ref": "#/$defs/strings"}, "holdout": {"$ref": "#/$defs/strings"}}}, "exhaustive": {"const": true}, "disjoint": {"const": true}, "digest": {"$ref": "#/$defs/digest"}}},
    "negativeKnowledge": {"type": "object", "additionalProperties": false, "required": ["holdout_ids", "candidate_generation_exclusions", "source_ids", "exclusion_reason"], "properties": {"holdout_ids": {"$ref": "#/$defs/strings"}, "candidate_generation_exclusions": {"$ref": "#/$defs/strings"}, "source_ids": {"$ref": "#/$defs/strings"}, "exclusion_reason": {"type": "string", "minLength": 1}}},
    "candidateContract": {"type": "object", "additionalProperties": false, "required": ["proven", "claim_status", "canonical", "promotion_requires_human_review"], "properties": {"proven": {"const": false}, "claim_status": {"const": "proposed"}, "canonical": {"const": false}, "promotion_requires_human_review": {"const": true}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["provider", "exact_model_id", "prompt_digest", "input_bundle_digest"], "properties": {"provider": {"type": ["string", "null"]}, "exact_model_id": {"type": ["string", "null"]}, "prompt_digest": {"type": ["string", "null"]}, "input_bundle_digest": {"type": ["string", "null"]}, "runtime_digest": {"type": ["string", "null"]}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "status", "definition", "input_partition", "output_bound", "provenance", "secret_safe_output"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1}, "status": {"enum": ["protocol-defined", "evaluated", "not-evaluated"]}, "definition": {"type": "string", "minLength": 1}, "input_partition": {"enum": ["train", "evaluation", "holdout"]}, "output_bound": {"type": "integer", "minimum": 1}, "provenance": {"$ref": "#/$defs/provenance"}, "secret_safe_output": {"type": "boolean"}, "not_evaluated_reason": {"type": "string", "minLength": 1}}},
    "futureHooks": {"type": "object", "additionalProperties": false, "required": ["reviewer_labels", "llm_runs", "prototype_runs"], "properties": {"reviewer_labels": {"$ref": "#/$defs/hook"}, "llm_runs": {"$ref": "#/$defs/hook"}, "prototype_runs": {"$ref": "#/$defs/hook"}}},
    "hook": {"type": "object", "additionalProperties": false, "required": ["status", "artifact"], "properties": {"status": {"const": "reserved"}, "artifact": {"type": ["string", "null"]}, "expected_fields": {"$ref": "#/$defs/strings"}, "required_provenance": {"$ref": "#/$defs/strings"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["name", "numerator", "denominator", "value", "status", "reason"], "properties": {"name": {"type": "string", "minLength": 1}, "numerator": {"const": 0}, "denominator": {"const": 0}, "value": {"type": ["number", "null"]}, "status": {"const": "not-evaluated"}, "reason": {"type": "string", "minLength": 1}}},
    "reviewBudget": {"type": "object", "additionalProperties": false, "required": ["planned_reviewer_count", "max_candidate_records", "max_minutes", "labeling_status", "budget_is_not_result"], "properties": {"planned_reviewer_count": {"type": "integer", "minimum": 0}, "max_candidate_records": {"type": "integer", "minimum": 0}, "max_minutes": {"type": "integer", "minimum": 0}, "labeling_status": {"enum": ["not-started", "in-progress", "complete"]}, "budget_is_not_result": {"const": true}}},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "not-evaluated"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
