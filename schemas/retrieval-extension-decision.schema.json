{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/retrieval-extension-decision.schema.json",
  "title": "Mathen retrieval extension decision",
  "description": "Research decision record; it does not authorize a provider, resource, or deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "task",
    "as_of",
    "decision",
    "scope",
    "corpus",
    "criteria",
    "options",
    "experiment_gate",
    "rollback",
    "unresolved_questions"
  ],
  "properties": {
    "decision_id": { "type": "string", "const": "MTH-0147" },
    "task": {
      "type": "string",
      "const": "Evaluate embeddings and Vectorize for evidence-bounded retrieval"
    },
    "as_of": { "type": "string", "format": "date" },
    "decision": {
      "type": "string",
      "enum": ["no_change", "gated_experiment", "proceed_to_implementation"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_changes",
        "similarity_boundary",
        "canonical_source"
      ],
      "properties": {
        "production_changes": { "type": "boolean", "const": false },
        "similarity_boundary": { "type": "string", "const": "discovery_only" },
        "canonical_source": { "type": "string", "const": "d1" }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reviewed_only",
        "snapshot_commit",
        "snapshot_digest",
        "counts",
        "evidence_closure",
        "scope_metadata",
        "freshness"
      ],
      "properties": {
        "source": { "type": "string", "const": "data/systems/*.json" },
        "reviewed_only": { "type": "boolean", "const": true },
        "snapshot_commit": { "type": "string", "minLength": 1 },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cards",
            "features",
            "views",
            "trade_offs",
            "evidence",
            "eligible_documents"
          ],
          "properties": {
            "cards": { "type": "integer", "minimum": 0 },
            "features": { "type": "integer", "minimum": 0 },
            "views": { "type": "integer", "minimum": 0 },
            "trade_offs": { "type": "integer", "minimum": 0 },
            "evidence": { "type": "integer", "minimum": 0 },
            "eligible_documents": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence_closure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing_references",
            "records_with_local_evidence",
            "evidence_kinds"
          ],
          "properties": {
            "missing_references": { "type": "integer", "const": 0 },
            "records_with_local_evidence": { "type": "integer", "minimum": 0 },
            "evidence_kinds": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "scope_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cards_with_any_scope_context",
            "evidence_with_scope_context",
            "specified_dimensions",
            "interpretation"
          ],
          "properties": {
            "cards_with_any_scope_context": { "type": "integer", "minimum": 0 },
            "evidence_with_scope_context": { "type": "integer", "minimum": 0 },
            "specified_dimensions": { "type": "integer", "minimum": 0 },
            "interpretation": {
              "type": "string",
              "const": "absence_is_not_a_negative_finding"
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_accessed",
            "evidence_missing_accessed",
            "policy"
          ],
          "properties": {
            "evidence_accessed": { "type": "integer", "minimum": 0 },
            "evidence_missing_accessed": { "type": "integer", "minimum": 0 },
            "policy": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "observation", "consequence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "observation": { "type": "string", "minLength": 1 },
          "consequence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["chosen", "research_only", "deferred"]
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "experiment_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "entry_gates",
        "acceptance_gates",
        "required_metrics",
        "boundary"
      ],
      "properties": {
        "status": { "type": "string", "const": "not_started" },
        "entry_gates": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance_gates": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_metrics": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "boundary": {
          "type": "string",
          "const": "research_only_no_production_resource"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "trigger_conditions",
        "canonical_data_untouched"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "const": "versioned_index_atomic_pointer_rollback"
        },
        "trigger_conditions": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "canonical_data_untouched": { "type": "boolean", "const": true }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
