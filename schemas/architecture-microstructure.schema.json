{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/architecture-microstructure.schema.json",
  "title": "Mathen Architecture Microstructure",
  "description": "An evidence-backed architectural unit at an explicit scale. This is a candidate knowledge document, not a proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "summary",
    "scale",
    "role",
    "state",
    "events",
    "operations",
    "inputs",
    "outputs",
    "preconditions",
    "postconditions",
    "invariants",
    "boundaries",
    "resource_effects",
    "failure_modes",
    "validity_scope",
    "claim_type",
    "claim_status",
    "evidence_ids",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "scale": { "$ref": "#/$defs/scale" },
    "role": { "$ref": "#/$defs/role" },
    "state": { "type": "array", "items": { "$ref": "#/$defs/state" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "postconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "invariants": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
    "boundaries": { "type": "array", "items": { "$ref": "#/$defs/boundary" } },
    "resource_effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourceEffect" }
    },
    "failure_modes": {
      "type": "array",
      "items": { "$ref": "#/$defs/failureMode" }
    },
    "validity_scope": { "$ref": "#/$defs/validityScope" },
    "claim_type": { "$ref": "#/$defs/claimType" },
    "claim_status": { "$ref": "#/$defs/claimStatus" },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "claimType": {
      "type": "string",
      "enum": ["fact", "inference", "hypothesis", "analogy"]
    },
    "claimStatus": {
      "type": "string",
      "enum": ["proposed", "under-review", "accepted", "rejected", "deprecated"]
    },
    "claimFields": {
      "type": "object",
      "required": ["claim_type", "claim_status", "evidence_ids"],
      "properties": {
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "scale": {
      "allOf": [
        { "$ref": "#/$defs/claimFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "unit", "description"],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "primitive",
                "mechanism",
                "subsystem",
                "system",
                "ecosystem"
              ]
            },
            "unit": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "claim_type": { "$ref": "#/$defs/claimType" },
            "claim_status": { "$ref": "#/$defs/claimStatus" },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "role": { "$ref": "#/$defs/claimObject" },
    "state": { "$ref": "#/$defs/element" },
    "event": {
      "allOf": [
        { "$ref": "#/$defs/element" },
        {
          "type": "object",
          "properties": {
            "source_state": { "$ref": "#/$defs/id" },
            "target_state": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "operation": {
      "allOf": [
        { "$ref": "#/$defs/element" },
        {
          "type": "object",
          "properties": {
            "input_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "output_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "precondition_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "postcondition_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "input": { "$ref": "#/$defs/io" },
    "output": { "$ref": "#/$defs/io" },
    "condition": { "$ref": "#/$defs/element" },
    "boundary": {
      "allOf": [
        { "$ref": "#/$defs/element" },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "inside": { "type": "string", "minLength": 1 },
            "outside": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "resourceEffect": {
      "allOf": [
        { "$ref": "#/$defs/element" },
        {
          "type": "object",
          "properties": {
            "resource": { "type": "string", "minLength": 1 },
            "effect": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "failureMode": {
      "allOf": [
        { "$ref": "#/$defs/element" },
        {
          "type": "object",
          "properties": {
            "trigger": { "type": "string", "minLength": 1 },
            "effect": { "type": "string", "minLength": 1 },
            "recovery": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "element": {
      "allOf": [
        { "$ref": "#/$defs/claimFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "description"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "initial": { "type": "boolean" },
            "terminal": { "type": "boolean" },
            "source_state": { "$ref": "#/$defs/id" },
            "target_state": { "$ref": "#/$defs/id" },
            "input_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "output_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "precondition_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "postcondition_ids": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "type": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "destination": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "inside": { "type": "string", "minLength": 1 },
            "outside": { "type": "string", "minLength": 1 },
            "resource": { "type": "string", "minLength": 1 },
            "effect": { "type": "string", "minLength": 1 },
            "trigger": { "type": "string", "minLength": 1 },
            "recovery": { "type": "string", "minLength": 1 },
            "claim_type": { "$ref": "#/$defs/claimType" },
            "claim_status": { "$ref": "#/$defs/claimStatus" },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "io": {
      "allOf": [
        { "$ref": "#/$defs/element" },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "destination": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "claimObject": {
      "allOf": [
        { "$ref": "#/$defs/claimFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "claim_type": { "$ref": "#/$defs/claimType" },
            "claim_status": { "$ref": "#/$defs/claimStatus" },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "validityScope": {
      "allOf": [
        { "$ref": "#/$defs/claimFields" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "systems",
            "versions",
            "deployment_origins",
            "conditions",
            "exclusions"
          ],
          "properties": {
            "systems": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "versions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "deployment_origins": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "conditions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "exclusions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "claim_type": { "$ref": "#/$defs/claimType" },
            "claim_status": { "$ref": "#/$defs/claimStatus" },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "uri"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": [
            "official-doc",
            "paper",
            "source-code",
            "experiment",
            "secondary"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "accessed": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
