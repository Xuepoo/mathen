{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/repeated-agent-review-pilot.schema.json",
  "title": "Mathen MTH-0193 repeated agent-only review pilot",
  "description": "Two independent research-only observations over the MTH-0185 enriched packet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "reviewer_kind",
    "human_review",
    "research_only",
    "non_canonical",
    "pilot_id",
    "study_id",
    "study_packet_digest",
    "source_digests",
    "run_count",
    "runs",
    "non_claims",
    "promotion_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_kind": {
      "const": "agent-review-repeated-pilot"
    },
    "reviewer_kind": {
      "const": "agent"
    },
    "human_review": {
      "const": false
    },
    "research_only": {
      "const": true
    },
    "non_canonical": {
      "const": true
    },
    "pilot_id": {
      "const": "mth-0193"
    },
    "study_id": {
      "const": "mth-0185-enriched-study"
    },
    "study_packet_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/digest"
      }
    },
    "run_count": {
      "const": 2
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "non_claims": {
      "$ref": "#/$defs/strings"
    },
    "promotion_decision": {
      "const": "not-determined"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "ended_at",
        "elapsed_seconds",
        "measurement_status",
        "scope"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "ended_at": {
          "type": "string",
          "minLength": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "measurement_status": {
          "const": "observed"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assignmentDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "assignment_id",
        "candidate_digest",
        "evidence_digests",
        "negative_knowledge_digests",
        "source_digest"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "negative_knowledge_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "run": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "reviewer_kind",
        "human_review",
        "research_only",
        "non_canonical",
        "promotion_decision",
        "record_kind",
        "run_id",
        "run_seed",
        "packet_labels",
        "run_timing",
        "packets",
        "observations"
      ],
      "properties": {
        "reviewer_kind": {
          "const": "agent"
        },
        "human_review": {
          "const": false
        },
        "research_only": {
          "const": true
        },
        "non_canonical": {
          "const": true
        },
        "promotion_decision": {
          "const": "not-determined"
        },
        "record_kind": {
          "const": "agent-review-run"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_seed": {
          "type": "string",
          "minLength": 1
        },
        "packet_labels": {
          "type": "array",
          "enum": [
            [
              "A",
              "B"
            ],
            [
              "B",
              "A"
            ]
          ]
        },
        "run_timing": {
          "$ref": "#/$defs/timing"
        },
        "packets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/runPacket"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/observation"
          }
        }
      },
      "additionalProperties": false
    },
    "runPacket": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "reviewer_kind",
        "human_review",
        "research_only",
        "non_canonical",
        "promotion_decision",
        "record_kind",
        "run_id",
        "run_seed",
        "packet_label",
        "packet_id",
        "packet_digest",
        "contract_pilot_id",
        "contract_digest",
        "assignment_order",
        "assignment_digests",
        "observation_count"
      ],
      "properties": {
        "reviewer_kind": {
          "const": "agent"
        },
        "human_review": {
          "const": false
        },
        "research_only": {
          "const": true
        },
        "non_canonical": {
          "const": true
        },
        "promotion_decision": {
          "const": "not-determined"
        },
        "record_kind": {
          "const": "agent-review-run-packet"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_seed": {
          "type": "string",
          "minLength": 1
        },
        "packet_label": {
          "enum": [
            "A",
            "B"
          ]
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_digest": {
          "$ref": "#/$defs/digest"
        },
        "contract_pilot_id": {
          "enum": [
            "mth-0186",
            "mth-0187"
          ]
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "assignment_order": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assignment_digests": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/assignmentDigest"
          }
        },
        "observation_count": {
          "const": 8
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "reviewer_kind",
        "human_review",
        "research_only",
        "non_canonical",
        "promotion_decision",
        "record_kind",
        "run_id",
        "run_seed",
        "packet_label",
        "packet_id",
        "packet_digest",
        "contract_pilot_id",
        "contract_digest",
        "order",
        "task_id",
        "assignment_id",
        "domain_id",
        "partition",
        "candidate_statement",
        "candidate_claim_type",
        "candidate_digest",
        "evidence_ids",
        "evidence_excerpt_digests",
        "source_ids",
        "source_digest",
        "negative_knowledge_refs",
        "negative_knowledge_digests",
        "scope_context",
        "locality",
        "labels",
        "notes",
        "timing"
      ],
      "properties": {
        "reviewer_kind": {
          "const": "agent"
        },
        "human_review": {
          "const": false
        },
        "research_only": {
          "const": true
        },
        "non_canonical": {
          "const": true
        },
        "promotion_decision": {
          "const": "not-determined"
        },
        "record_kind": {
          "const": "agent-review-observation"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_seed": {
          "type": "string",
          "minLength": 1
        },
        "packet_label": {
          "enum": [
            "A",
            "B"
          ]
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_digest": {
          "$ref": "#/$defs/digest"
        },
        "contract_pilot_id": {
          "enum": [
            "mth-0186",
            "mth-0187"
          ]
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "domain_id": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "enum": [
            "train",
            "evaluation"
          ]
        },
        "candidate_statement": {
          "type": "string",
          "minLength": 1
        },
        "candidate_claim_type": {
          "enum": [
            "fact",
            "inference",
            "hypothesis",
            "analogy"
          ]
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_ids": {
          "$ref": "#/$defs/strings"
        },
        "evidence_excerpt_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "source_ids": {
          "$ref": "#/$defs/strings"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "negative_knowledge_refs": {
          "$ref": "#/$defs/strings"
        },
        "negative_knowledge_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "scope_context": {
          "type": "object"
        },
        "locality": {
          "type": "object"
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_support",
            "claim_type",
            "scope_completeness",
            "false_link",
            "counterexample_awareness",
            "usefulness",
            "abstention",
            "reviewer_effort"
          ],
          "properties": {
            "evidence_support": {
              "$ref": "#/$defs/label"
            },
            "claim_type": {
              "$ref": "#/$defs/label"
            },
            "scope_completeness": {
              "$ref": "#/$defs/label"
            },
            "false_link": {
              "$ref": "#/$defs/label"
            },
            "counterexample_awareness": {
              "$ref": "#/$defs/label"
            },
            "usefulness": {
              "$ref": "#/$defs/label"
            },
            "abstention": {
              "$ref": "#/$defs/label"
            },
            "reviewer_effort": {
              "$ref": "#/$defs/label"
            }
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/timing"
        }
      },
      "additionalProperties": false
    },
    "label": {
      "enum": [
        "supported",
        "partially-supported",
        "unsupported",
        "fact",
        "inference",
        "hypothesis",
        "analogy",
        "complete",
        "partial",
        "incomplete",
        "false",
        "not-false",
        "aware",
        "unaware",
        "not-applicable",
        "useful",
        "somewhat-useful",
        "not-useful",
        "abstained",
        "not-abstained",
        "low",
        "medium",
        "high",
        "unknown",
        "not-recorded"
      ]
    }
  }
}
