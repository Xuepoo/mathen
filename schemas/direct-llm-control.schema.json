{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/direct-llm-control.schema.json",
  "title": "Mathen research-only direct-LLM control manifest",
  "description": "Secret-safe provenance and evidence boundary for a direct-LLM control; it is not a model result or canonical evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_kind", "schema_version", "run_id", "protocol_version", "benchmark_version", "input_bundle", "prompt", "provider", "runtime", "sampling", "output", "candidates", "result_boundary", "outcome"],
  "properties": {
    "manifest_kind": { "const": "direct_llm_control" },
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/text" },
    "protocol_version": { "$ref": "#/$defs/text" },
    "benchmark_version": { "$ref": "#/$defs/text" },
    "input_bundle": { "$ref": "#/$defs/inputBundle" },
    "prompt": { "$ref": "#/$defs/prompt" },
    "provider": { "$ref": "#/$defs/provider" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "sampling": { "$ref": "#/$defs/sampling" },
    "output": { "$ref": "#/$defs/output" },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "result_boundary": { "$ref": "#/$defs/resultBoundary" },
    "outcome": { "$ref": "#/$defs/outcome" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": { "type": "array", "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
    "nonEmptyStringList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" }, "uniqueItems": true },
    "inputBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest", "evidence_ids"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "digest": { "$ref": "#/$defs/digest" }, "evidence_ids": { "$ref": "#/$defs/stringList" } }
    },
    "prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "exact_model_id"],
      "properties": { "name": { "$ref": "#/$defs/text" }, "exact_model_id": { "$ref": "#/$defs/text" } }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_kind", "runtime_version", "runner_version", "source_revision", "execution_environment"],
      "properties": {
        "runtime_kind": { "$ref": "#/$defs/text" }, "runtime_version": { "$ref": "#/$defs/text" },
        "runner_version": { "$ref": "#/$defs/text" }, "source_revision": { "$ref": "#/$defs/text" },
        "execution_environment": { "$ref": "#/$defs/text" }
      }
    },
    "sampling": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "decoding_parameters"],
      "properties": { "seed": { "type": "integer" }, "decoding_parameters": { "type": "object" } }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "digest", "secret_safe", "record_count"],
      "properties": {
        "status": { "enum": ["absent", "available", "redacted"] },
        "digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "secret_safe": { "const": true }, "record_count": { "type": "integer", "minimum": 0 },
        "storage_ref": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim_type", "text", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "claim_type": { "enum": ["fact", "inference", "hypothesis", "analogy"] },
        "text": { "$ref": "#/$defs/text" }, "evidence_ids": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "evidence_ids", "claims", "proven"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "evidence_ids": { "$ref": "#/$defs/nonEmptyStringList" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }, "proven": { "const": false }
      }
    },
    "resultBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical", "promotion_requires_human_review", "storage_scope"],
      "properties": { "canonical": { "const": false }, "promotion_requires_human_review": { "const": true }, "storage_scope": { "enum": ["research", "draft"] } }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": { "status": { "enum": ["accepted", "rejected", "undetermined", "falsified", "not-evaluated"] }, "reason": { "$ref": "#/$defs/text" } }
    }
  }
}
