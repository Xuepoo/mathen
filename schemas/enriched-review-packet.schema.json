{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/enriched-review-packet.schema.json",
  "title": "Mathen MTH-0185 enriched research review packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_kind", "schema_version", "protocol_version", "study_id", "research_only", "purpose", "frozen_inputs", "reproducibility", "reviewer_pool", "balance", "holdout_isolation", "instructions", "packets", "review_records", "results", "non_claims"],
  "properties": {
    "study_kind": {"const": "blinded_enriched_reviewer_study"},
    "schema_version": {"const": "1.0"},
    "protocol_version": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "research_only": {"const": true},
    "purpose": {"type": "string", "minLength": 1},
    "frozen_inputs": {"$ref": "#/$defs/frozenInputs"},
    "reproducibility": {"type": "object", "additionalProperties": false, "required": ["assignment_seed", "reviewer_count", "generated_at"], "properties": {"assignment_seed": {"type": "string", "minLength": 1}, "reviewer_count": {"const": 2}, "generated_at": {"type": "string", "minLength": 1}}},
    "reviewer_pool": {"type": "object", "additionalProperties": false, "required": ["count", "independent", "identity_visibility", "reviewer_keys"], "properties": {"count": {"const": 2}, "independent": {"const": true}, "identity_visibility": {"const": "opaque"}, "reviewer_keys": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^blind-seat-[a-z-]+$"}}}},
    "balance": {"type": "object", "additionalProperties": false, "required": ["balanced", "packet_labels", "tasks_per_reviewer", "overlap_policy", "domain_task_counts"], "properties": {"balanced": {"const": true}, "packet_labels": {"const": ["A", "B"]}, "tasks_per_reviewer": {"type": "integer", "minimum": 1}, "overlap_policy": {"const": "all-reviewers-review-all-non-holdout-tasks"}, "domain_task_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}}},
    "holdout_isolation": {"$ref": "#/$defs/holdout"},
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "packets": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/packet"}},
    "review_records": {"type": "array", "maxItems": 0},
    "results": {"type": "object", "additionalProperties": false, "required": ["status", "agreement", "promotion_decision"], "properties": {"status": {"const": "not-started"}, "agreement": {"const": "not-determined"}, "promotion_decision": {"const": "not-determined"}}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "frozenInputs": {"type": "object", "additionalProperties": false, "required": ["benchmark_ref", "benchmark_version", "study_ref", "study_version", "negative_knowledge_ref", "source_digests", "source_digest_semantics"], "properties": {"benchmark_ref": {"type": "string"}, "benchmark_version": {"type": "string"}, "study_ref": {"type": "string"}, "study_version": {"type": "string"}, "negative_knowledge_ref": {"type": "string"}, "source_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}, "source_digest_semantics": {"type": "string", "minLength": 1}}},
    "holdout": {"type": "object", "additionalProperties": false, "required": ["partition", "task_ids", "candidate_content_in_packets", "evidence_content_in_packets", "negative_knowledge_content_in_packets", "allowed_reference", "reason"], "properties": {"partition": {"const": "holdout"}, "task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "candidate_content_in_packets": {"const": false}, "evidence_content_in_packets": {"const": false}, "negative_knowledge_content_in_packets": {"const": false}, "allowed_reference": {"type": "string"}, "reason": {"type": "string"}}},
    "packet": {"type": "object", "additionalProperties": false, "required": ["packet_id", "packet_label", "reviewer_key", "assignments", "review_records"], "properties": {"packet_id": {"type": "string"}, "packet_label": {"enum": ["A", "B"]}, "reviewer_key": {"type": "string"}, "assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assignment"}}, "review_records": {"type": "array", "maxItems": 0}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["assignment_id", "reviewer_key", "task_id", "domain_id", "partition", "order", "candidate", "evidence", "negative_knowledge", "scope_context", "locality"], "properties": {"assignment_id": {"type": "string"}, "reviewer_key": {"type": "string"}, "task_id": {"type": "string"}, "domain_id": {"type": "string"}, "partition": {"enum": ["train", "evaluation"]}, "order": {"type": "integer", "minimum": 1}, "candidate": {"$ref": "#/$defs/candidate"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "negative_knowledge": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/negative"}}, "scope_context": {"type": "object", "additionalProperties": true}, "locality": {"$ref": "#/$defs/locality"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "statement", "claim_type", "proven", "scope", "system_ids", "task_id", "evidence_ids", "source_ids", "candidate_digest", "notes"], "properties": {"candidate_id": {"type": "string"}, "statement": {"type": "string"}, "claim_type": {"enum": ["fact", "inference", "hypothesis", "analogy"]}, "proven": {"const": false}, "scope": {"type": "object", "additionalProperties": true}, "system_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "task_id": {"type": "string"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "candidate_digest": {"$ref": "#/$defs/digest"}, "notes": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "card_id", "source_id", "claim_type", "source_ref", "excerpt", "excerpt_digest"], "properties": {"evidence_id": {"type": "string"}, "card_id": {"type": "string"}, "source_id": {"type": "string"}, "claim_type": {"const": "fact"}, "source_ref": {"type": "string"}, "excerpt": {"type": "object", "additionalProperties": true}, "excerpt_digest": {"$ref": "#/$defs/digest"}}},
    "negative": {"type": "object", "additionalProperties": false, "required": ["negative_knowledge_id", "reference_id", "claim_type", "digest"], "properties": {"negative_knowledge_id": {"type": "string"}, "reference_id": {"type": "string"}, "claim_type": {"enum": ["fact", "inference", "hypothesis", "analogy"]}, "digest": {"$ref": "#/$defs/digest"}}},
    "locality": {"type": "object", "additionalProperties": false, "required": ["candidate_evidence_local", "candidate_evidence_ids", "source_ids", "source_digest"], "properties": {"candidate_evidence_local": {"const": true}, "candidate_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_digest": {"$ref": "#/$defs/digest"}}}
  }
}
