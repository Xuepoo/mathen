{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/architecture-card.schema.json",
  "title": "Mathen Architecture Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "summary",
    "scope",
    "features",
    "mathematical_views",
    "trade_offs",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version_context": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "scope_context": { "$ref": "#/$defs/scopeContext" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    },
    "mathematical_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/mathematicalView" }
    },
    "trade_offs": {
      "type": "array",
      "items": { "$ref": "#/$defs/tradeOff" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "related_systems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "temporal_context": { "$ref": "#/$defs/temporalContext" },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "feature_relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/featureRelation" }
    },
    "composition": { "$ref": "#/$defs/composition" }
  },
  "$defs": {
    "claimType": {
      "type": "string",
      "enum": ["fact", "inference", "hypothesis", "analogy"]
    },
    "claimStatus": {
      "type": "string",
      "enum": ["proposed", "under-review", "accepted", "rejected", "deprecated"]
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "claim_type", "claim_status", "evidence_ids"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "temporalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_status", "evidence_ids"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "valid_from": { "type": "string", "minLength": 1 },
        "valid_to": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "current",
            "superseded",
            "deprecated",
            "historical"
          ]
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "superseded_by": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "claim_type",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["uses", "extends", "composes", "resembles", "influenced-by"]
        },
        "target": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "notes": { "type": "string" }
      }
    },
    "featureRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_feature_id",
        "target_system_id",
        "target_feature_id",
        "type",
        "claim_type",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "source_feature_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "target_system_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "target_feature_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": {
          "type": "string",
          "enum": [
            "implements",
            "refines",
            "requires",
            "supports",
            "conflicts-with",
            "composes",
            "resembles"
          ]
        },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "notes": { "type": "string" }
      }
    },
    "compositionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "role", "claim_status", "evidence_ids"],
      "properties": {
        "system_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "role": { "type": "string", "minLength": 1 },
        "version_context": { "type": "string" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "constraints",
        "preserved_properties",
        "conflicts",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compositionInput" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "preserved_properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "validation_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "typed_semantics": {
          "$ref": "architecture-typed-composition.schema.json"
        },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "claim_type",
        "description",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "description": { "type": "string", "minLength": 1 },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "costs": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "scope_context": { "$ref": "#/$defs/scopeContext" }
      }
    },
    "mathematicalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "question",
        "assumptions",
        "claim_type",
        "evidence_ids"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "contract": {
          "$ref": "architecture-mathematical-view.schema.json"
        },
        "scope_context": { "$ref": "#/$defs/scopeContext" }
      }
    },
    "tradeOff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "benefits", "costs"],
      "properties": {
        "feature_id": { "type": "string" },
        "benefits": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "costs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "uri"],
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "experiment" } }
          },
          "then": {
            "required": [
              "protocol",
              "system_commit",
              "environment",
              "command",
              "dataset",
              "repetitions",
              "metrics",
              "artifacts"
            ]
          }
        },
        {
          "if": {
            "required": ["kind", "observation_version"],
            "properties": {
              "kind": { "enum": ["experiment", "benchmark", "fault-injection", "operational-observation", "counterexample", "negative-result"] }
            }
          },
          "then": {
            "required": ["protocol", "system_commit", "command", "dataset", "repetitions", "metrics", "artifacts", "observation_version", "workload", "environment", "conditions", "provenance", "result_boundary", "result", "review", "scope_context"]
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "fault-injection" } } },
          "then": { "required": ["failure"] }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "counterexample" } } },
          "then": { "required": ["counterexample"] }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "negative-result" } } },
          "then": { "required": ["negative_result"] }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["benchmark", "fault-injection", "operational-observation", "counterexample", "negative-result"] }
            }
          },
          "then": { "required": ["observation_version"] }
        }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": {
          "type": "string",
          "enum": [
            "official-doc",
            "paper",
            "source-code",
            "experiment",
            "benchmark",
            "fault-injection",
            "operational-observation",
            "counterexample",
            "negative-result",
            "secondary"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "accessed": { "type": "string" },
        "notes": { "type": "string" },
        "protocol": { "type": "string", "minLength": 1 },
        "system_commit": { "type": "string", "minLength": 1 },
        "environment": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/metadataObject" }
          ]
        },
        "command": { "type": "string", "minLength": 1 },
        "dataset": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/metadataObject" }
          ]
        },
        "repetitions": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "$ref": "#/$defs/metadataObject" }
            ]
          }
        },
        "observation_version": { "const": "1" },
        "workload": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/metadataObject" }
          ]
        },
        "conditions": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/metadataObject" }
          ]
        },
        "provenance": { "$ref": "#/$defs/observationProvenance" },
        "result_boundary": { "$ref": "#/$defs/observationResultBoundary" },
        "result": { "$ref": "#/$defs/observationResult" },
        "review": { "$ref": "#/$defs/observationReview" },
        "failure": { "$ref": "#/$defs/failureRecord" },
        "counterexample": { "$ref": "#/$defs/counterexampleRecord" },
        "negative_result": { "$ref": "#/$defs/negativeResultRecord" },
        "scope_context": { "$ref": "#/$defs/scopeContext" }
      }
    },
    "metadataObject": {
      "type": "object",
      "additionalProperties": true
    },
    "observationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "source_revision", "protocol_digest", "recorded_at", "runner", "toolchain"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "protocol_digest": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "toolchain": { "oneOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/metadataObject" }] }
      }
    },
    "observationResultBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "promotion_requires_human_review", "storage_scope", "limits"],
      "properties": {
        "canonical": { "const": false },
        "promotion_requires_human_review": { "const": true },
        "storage_scope": { "enum": ["research", "draft"] },
        "limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "observationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "measurements"],
      "properties": {
        "status": { "enum": ["observed", "not-observed", "inconclusive", "abstained", "failed"] },
        "summary": { "type": "string", "minLength": 1 },
        "abstention_reason": { "type": "string", "minLength": 1 },
        "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "unit", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string", "minLength": 1 },
        "status": { "enum": ["observed", "not-observed", "not-measured", "abstained"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "observationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "card_claim_refs"],
      "properties": {
        "status": { "enum": ["unreviewed", "reviewed"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "minLength": 1 },
        "card_claim_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "failureRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "observed_behavior", "boundary", "evidence_ids"],
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "observed_behavior": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "counterexampleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_claim", "condition", "observed_result", "implication", "evidence_ids"],
      "properties": {
        "target_claim": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "observed_result": { "type": "string", "minLength": 1 },
        "implication": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "negativeResultRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "result", "reason", "evidence_ids"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scopeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validity_scope", "workload", "runtime_conditions", "scale", "failure_conditions"],
      "properties": {
        "validity_scope": { "$ref": "#/$defs/validityScopeDimension" },
        "workload": { "$ref": "#/$defs/scopeDimension" },
        "runtime_conditions": { "$ref": "#/$defs/scopeDimension" },
        "scale": { "$ref": "#/$defs/scopeDimension" },
        "failure_conditions": { "$ref": "#/$defs/scopeDimension" }
      }
    },
    "scopeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "values", "evidence_ids"],
      "properties": {
        "status": { "enum": ["specified", "unknown", "unspecified", "not-applicable"] },
        "values": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["specified", "unknown", "not-applicable"] } } },
          "then": { "required": ["claim_type", "claim_status"], "properties": { "evidence_ids": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "specified" } } },
          "then": { "properties": { "values": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "not-applicable" } } },
          "then": { "required": ["notes"] }
        },
        {
          "if": { "properties": { "status": { "const": "unspecified" } } },
          "then": {
            "properties": { "values": { "maxItems": 0 }, "evidence_ids": { "maxItems": 0 } },
            "not": { "anyOf": [{ "required": ["claim_type"] }, { "required": ["claim_status"] }] }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["unknown", "not-applicable"] } } },
          "then": { "properties": { "values": { "maxItems": 0 } } }
        }
      ]
    },
    "validityScopeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "systems", "versions", "deployment_origins", "conditions", "exclusions", "evidence_ids"],
      "properties": {
        "status": { "enum": ["specified", "unknown", "unspecified", "not-applicable"] },
        "systems": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "versions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "deployment_origins": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "conditions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "notes": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["specified", "unknown", "not-applicable"] } } },
          "then": { "required": ["claim_type", "claim_status"], "properties": { "evidence_ids": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "specified" } } },
          "then": {
            "anyOf": [
              { "properties": { "systems": { "minItems": 1 } } },
              { "properties": { "versions": { "minItems": 1 } } },
              { "properties": { "deployment_origins": { "minItems": 1 } } },
              { "properties": { "conditions": { "minItems": 1 } } },
              { "properties": { "exclusions": { "minItems": 1 } } }
            ]
          }
        },
        {
          "if": { "properties": { "status": { "const": "not-applicable" } } },
          "then": { "required": ["notes"] }
        },
        {
          "if": { "properties": { "status": { "const": "unspecified" } } },
          "then": {
            "properties": {
              "systems": { "maxItems": 0 },
              "versions": { "maxItems": 0 },
              "deployment_origins": { "maxItems": 0 },
              "conditions": { "maxItems": 0 },
              "exclusions": { "maxItems": 0 },
              "evidence_ids": { "maxItems": 0 }
            },
            "not": { "anyOf": [{ "required": ["claim_type"] }, { "required": ["claim_status"] }] }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["unknown", "not-applicable"] } } },
          "then": {
            "properties": {
              "systems": { "maxItems": 0 },
              "versions": { "maxItems": 0 },
              "deployment_origins": { "maxItems": 0 },
              "conditions": { "maxItems": 0 },
              "exclusions": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
