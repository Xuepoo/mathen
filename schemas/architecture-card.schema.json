{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/architecture-card.schema.json",
  "title": "Mathen Architecture Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "summary",
    "scope",
    "features",
    "mathematical_views",
    "trade_offs",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version_context": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    },
    "mathematical_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/mathematicalView" }
    },
    "trade_offs": {
      "type": "array",
      "items": { "$ref": "#/$defs/tradeOff" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "related_systems": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "claimType": {
      "type": "string",
      "enum": ["fact", "inference", "hypothesis", "analogy"]
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "claim_type",
        "description",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "description": { "type": "string", "minLength": 1 },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "costs": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "mathematicalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "question",
        "assumptions",
        "claim_type",
        "evidence_ids"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tradeOff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "benefits", "costs"],
      "properties": {
        "feature_id": { "type": "string" },
        "benefits": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "costs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "uri"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": {
          "type": "string",
          "enum": [
            "official-doc",
            "paper",
            "source-code",
            "experiment",
            "secondary"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "accessed": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
