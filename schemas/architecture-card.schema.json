{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/architecture-card.schema.json",
  "title": "Mathen Architecture Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "summary",
    "scope",
    "features",
    "mathematical_views",
    "trade_offs",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version_context": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature" }
    },
    "mathematical_views": {
      "type": "array",
      "items": { "$ref": "#/$defs/mathematicalView" }
    },
    "trade_offs": {
      "type": "array",
      "items": { "$ref": "#/$defs/tradeOff" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "related_systems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "temporal_context": { "$ref": "#/$defs/temporalContext" },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "composition": { "$ref": "#/$defs/composition" }
  },
  "$defs": {
    "claimType": {
      "type": "string",
      "enum": ["fact", "inference", "hypothesis", "analogy"]
    },
    "claimStatus": {
      "type": "string",
      "enum": ["proposed", "under-review", "accepted", "rejected", "deprecated"]
    },
    "claimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "claim_type", "claim_status", "evidence_ids"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "temporalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_status", "evidence_ids"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "valid_from": { "type": "string", "minLength": 1 },
        "valid_to": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["planned", "current", "superseded", "deprecated", "historical"]
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "superseded_by": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "claim_type", "claim_status", "evidence_ids"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["uses", "extends", "composes", "resembles", "influenced-by"]
        },
        "target": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "notes": { "type": "string" }
      }
    },
    "compositionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "role", "claim_status", "evidence_ids"],
      "properties": {
        "system_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "role": { "type": "string", "minLength": 1 },
        "version_context": { "type": "string" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "constraints",
        "preserved_properties",
        "conflicts",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compositionInput" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "preserved_properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimEvidence" }
        },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "claim_type",
        "description",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "description": { "type": "string", "minLength": 1 },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "costs": { "type": "array", "items": { "type": "string" } },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "mathematicalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "question",
        "assumptions",
        "claim_type",
        "evidence_ids"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "claim_type": { "$ref": "#/$defs/claimType" },
        "claim_status": { "$ref": "#/$defs/claimStatus" },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tradeOff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "benefits", "costs"],
      "properties": {
        "feature_id": { "type": "string" },
        "benefits": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "costs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "uri"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": {
          "type": "string",
          "enum": [
            "official-doc",
            "paper",
            "source-code",
            "experiment",
            "secondary"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri" },
        "accessed": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
