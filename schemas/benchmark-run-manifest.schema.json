{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathen.dev/schemas/benchmark-run-manifest.schema.json",
  "title": "Mathen MTH-0118 benchmark run manifest",
  "description": "An audit record for an evidence-bounded research run; it is not evidence or a canonical result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "protocol_version",
    "benchmark_version",
    "source_revisions",
    "evidence_bundle",
    "input_ids",
    "input_evidence",
    "split",
    "method",
    "provenance",
    "deployment",
    "randomness",
    "novelty",
    "analogy_policy",
    "candidates",
    "review",
    "result_boundary",
    "outcome"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": "string", "minLength": 1 },
    "benchmark_version": { "type": "string", "minLength": 1 },
    "source_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id"],
        "properties": {
          "repository_id": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 },
          "archive_digest": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["commit"] },
          { "required": ["archive_digest"] }
        ]
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "source_revision_digests", "evidence_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "source_revision_digests": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "evidence_ids": { "$ref": "#/$defs/stringList", "uniqueItems": true }
      }
    },
    "input_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systems",
        "features",
        "views",
        "microstructures",
        "compositions",
        "analogies",
        "negative_knowledge"
      ],
      "properties": {
        "systems": { "$ref": "#/$defs/stringList" },
        "features": { "$ref": "#/$defs/stringList" },
        "views": { "$ref": "#/$defs/stringList" },
        "microstructures": { "$ref": "#/$defs/stringList" },
        "compositions": { "$ref": "#/$defs/stringList" },
        "analogies": { "$ref": "#/$defs/stringList" },
        "negative_knowledge": { "$ref": "#/$defs/stringList" }
      }
    },
    "input_evidence": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/nonEmptyStringList" }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy", "partitions", "temporal_cutoff", "leakage_controls",
        "negative_knowledge_holdout_ids", "candidate_generation_exclusions"
      ],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "partitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "evaluation", "holdout"],
          "properties": {
            "train": { "$ref": "#/$defs/stringList" },
            "evaluation": { "$ref": "#/$defs/stringList" },
            "holdout": { "$ref": "#/$defs/stringList" }
          }
        },
        "temporal_cutoff": { "type": ["string", "null"], "minLength": 1 },
        "leakage_controls": { "$ref": "#/$defs/stringList" },
        "negative_knowledge_holdout_ids": { "$ref": "#/$defs/stringList" },
        "candidate_generation_exclusions": { "$ref": "#/$defs/stringList" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "baseline"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_bundle_digest", "deterministic_inspector"],
      "properties": {
        "provider": { "type": ["string", "null"], "minLength": 1 },
        "exact_model_id": { "type": ["string", "null"], "minLength": 1 },
        "prompt_digest": { "type": ["string", "null"], "minLength": 1 },
        "input_bundle_digest": { "type": "string", "minLength": 1 },
        "deterministic_inspector": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "provider": { "type": "null" },
            "exact_model_id": { "type": "null" }
          }
        },
        {
          "required": ["provider", "exact_model_id"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "exact_model_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "version", "conditions", "exclusions"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "conditions": { "$ref": "#/$defs/stringList" },
        "exclusions": { "$ref": "#/$defs/stringList" },
        "workload": { "type": ["string", "null"] },
        "scope_context": { "$ref": "architecture-card.schema.json#/$defs/scopeContext" }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "decoding_parameters"],
      "properties": {
        "seed": { "type": "integer" },
        "decoding_parameters": { "type": "object" }
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_window", "representation", "dimensions", "strata",
        "aggregate_score_allowed"
      ],
      "properties": {
        "reference_window": { "type": "string", "minLength": 1 },
        "representation": { "type": "string", "minLength": 1 },
        "dimensions": { "$ref": "#/$defs/nonEmptyStringList", "uniqueItems": true },
        "strata": { "$ref": "#/$defs/nonEmptyStringList" },
        "aggregate_score_allowed": { "const": false }
      }
    },
    "analogy_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "non_equivalence_required",
        "historical_influence_requires_direct_evidence",
        "substitutability_not_implied"
      ],
      "properties": {
        "non_equivalence_required": { "const": true },
        "historical_influence_requires_direct_evidence": { "const": true },
        "substitutability_not_implied": { "const": true }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_pool",
        "rubric_version",
        "blinded_assignment",
        "adjudication_record"
      ],
      "properties": {
        "reviewer_pool": { "$ref": "#/$defs/stringList" },
        "rubric_version": { "type": "string", "minLength": 1 },
        "blinded_assignment": { "type": "boolean" },
        "adjudication_record": { "type": "array", "minItems": 0 }
      }
    },
    "result_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "promotion_requires_human_review", "storage_scope"],
      "properties": {
        "canonical": { "const": false },
        "promotion_requires_human_review": { "const": true },
        "storage_scope": { "enum": ["research", "draft"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "undetermined",
            "falsified",
            "not-evaluated"
          ]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "observation_evidence_ids": {
      "$ref": "#/$defs/nonEmptyStringList",
      "uniqueItems": true
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "claim_type",
        "claim_status",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "claim_type": {
          "enum": ["fact", "inference", "hypothesis", "analogy"]
        },
        "claim_status": {
          "enum": [
            "proposed",
            "under-review",
            "accepted",
            "rejected",
            "deprecated"
          ]
        },
        "evidence_ids": {
          "$ref": "#/$defs/nonEmptyStringList",
          "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_ids", "claims", "validation_logs", "proven"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "$ref": "#/$defs/nonEmptyStringList",
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/claim" }
        },
        "validation_logs": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/validationLog" }
        },
        "proven": { "const": false }
      }
    },
    "validationLog": {
      "type": "object",
      "required": ["check", "result", "reason"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
