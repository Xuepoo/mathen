+            // End the pointers actually owned by the navigation controls. A
+            // fabricated touch pointer with ID 0 leaves the mouse tracked and
+            // makes OrbitControls resume a touch with no recorded position.
+            // Orbit stores IDs; Trackball stores the original pointer events.
+            [...(controls._pointers || [])].forEach(pointer => {
+              const pointerId = typeof pointer === 'number' ? pointer : pointer.pointerId;
+              const position = controls._pointerPositions?.[pointerId];
+              controls.domElement.ownerDocument.dispatchEvent(new PointerEvent('pointerup', {
+                pointerId,
+                pointerType: pointer.pointerType || (position ? 'touch' : 'mouse'),
