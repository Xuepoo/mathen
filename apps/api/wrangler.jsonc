{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mathen-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-21",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mathen-db",
			"database_id": "bf435496-a71a-46f7-8628-541b1e168135",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ARTIFACTS",
			"bucket_name": "mathen-artifacts-production"
		}
	],
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"APP_ENV": "production"
	}
}
