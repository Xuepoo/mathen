{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mathen-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-21",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mathen-db",
			"database_id": "bf435496-a71a-46f7-8628-541b1e168135",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "ARTIFACTS",
			"bucket_name": "mathen-artifacts-production"
		}
	],
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"APP_ENV": "production",
		"R2_BUCKET_PRODUCTION": "mathen-artifacts-production",
		"MCP_RATE_LIMIT_PER_MINUTE": "60",
		"MCP_RATE_LIMIT_WINDOW_SECONDS": "60",
		"MCP_ALLOWED_ORIGINS": "",
		// Public deployment settings; keep credentials in Wrangler secrets.
		"TURNSTILE_SITE_KEY": "",
		// Empty pins verification to the incoming request URL's hostname.
		"TURNSTILE_HOSTNAME": "",
		"TURNSTILE_SESSION_TTL_SECONDS": "3600"
	},
	"env": {
		"preview": {
			"name": "mathen-api-preview",
			"vars": {
				"APP_ENV": "preview",
				"R2_BUCKET_PREVIEW": "mathen-artifacts-preview",
				"MCP_RATE_LIMIT_PER_MINUTE": "30",
				"MCP_RATE_LIMIT_WINDOW_SECONDS": "60",
				"MCP_ALLOWED_ORIGINS": ""
			},
			"r2_buckets": [
				{
					"binding": "ARTIFACTS",
					"bucket_name": "mathen-artifacts-preview"
				}
			]
		}
	}
}
